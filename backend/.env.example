# Value Stream — Environment Configuration
# Copy this file to .env and fill in your values for local development.
# For Docker, set these in docker-compose.yml instead.

# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-change-in-production

# Data directory for the SQLite file (default: ../data relative to backend/)
# DATA_DIR=./data

# ── AI Provider ───────────────────────────────────────────────────────────────
# Options: "claude" | "gemini" | "ollama" | "none"
AI_PROVIDER=none

# ── Option A: Claude (Anthropic cloud) ───────────────────────────────────────
# AI_PROVIDER=claude
# AI_MODEL=claude-opus-4-5
# AI_API_KEY=sk-ant-...

# ── Option B: Gemini (Google AI Studio key, or Google Cloud) ────────────────
# Direct API key (from https://aistudio.google.com/apikey):
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash
# AI_API_KEY=AIza...
#
# Or Google Cloud with no distributable key — for a target environment that has Google
# Cloud access but no route to pull an API key out of this repo (leave AI_API_KEY unset;
# auth comes from Application Default Credentials instead):
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json   ← omit to use
#                                    `gcloud auth application-default login` or a GCE/Cloud
#                                    Run metadata server instead

# ── Option C: Ollama (on-premise) ────────────────────────────────────────────
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434
# AI_MODEL=llama3
# AI_API_KEY=        ← not needed for Ollama
